# =========================================================================
# Food Forest Sanctuary — High-Performance Caching & Server Rules
# =========================================================================
Options -Indexes +FollowSymLinks

# Clean .ics Calendar Feed Rewrite (/ical/{room}.ics -> api/ical_export.php?room={room})
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^ical/([a-zA-Z0-9_-]+)\.ics$ api/ical_export.php?room=$1 [L,QSA]
</IfModule>

# 1. Protect sensitive files
<FilesMatch "^\.|\.(db|sqlite|sqlite3|sql|log)$">
    Require all denied
</FilesMatch>

# 2. GZIP / Deflate Compression (Reduces payload size by ~80%)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 3. Dynamic PHP: NEVER Cache (Changes to texts & photos reflect instantly)
<IfModule LiteSpeed>
    CacheDisable public /
    CacheDisable private /
</IfModule>
<FilesMatch "\.(php|phtml|ics)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set X-Accel-Expires "0"
        Header set X-LiteSpeed-Cache-Control "no-cache, no-store"
        Header set CDN-Cache-Control "no-store"
        Header set Surrogate-Control "no-store"
        Header set Pragma "no-cache"
        Header set Expires "Thu, 01 Jan 1970 00:00:00 GMT"
    </IfModule>
</FilesMatch>

# 4. Static Media Caching (Fast 0ms repeat visits for images & fonts)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# 5. PHP Upload & Resource Limits
<IfModule mod_php.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 64M
    php_value post_max_size 64M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
